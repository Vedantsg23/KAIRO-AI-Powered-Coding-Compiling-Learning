# Copy to apps/web/.env.local for `make web` (never commit it).
# (The live site's own public settings are in infra/vercel/public-settings.json.)
#
# Optional: account sign-in with Google, GitHub or email through Supabase.
# Leave empty and students start as guests. Both values are public by design:
# the project URL and its publishable (anon) key from Supabase -> Project
# Settings -> API. Never put a service-role key here. See docs/accounts.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: more sign-in methods, each enabled in Supabase -> Authentication ->
# Providers first (email and password need nothing else): google,github,azure,phone
VITE_AUTH_PROVIDERS=
